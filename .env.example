# Copy to .env and source it, or export these directly. Every value has a working
# default - the tool runs with no configuration at all.

# Where the vault lives. Default: $XDG_DATA_HOME/govault/vault.gv
VAULT_PATH=

# How long an unlock session stays valid. It is a sliding window: using the vault
# postpones auto-lock, idling does not. Short on purpose - the session file holds live
# keys protected only by file permissions. See the threat model in docs/design.md.
VAULT_SESSION_TTL=15m

# How long a copied password stays on the clipboard before it is cleared. The clear is
# conditional: if you copied something else in the meantime, yours is left alone.
VAULT_CLIPBOARD_TIMEOUT=20s

# scrypt cost. N must be a power of two. Memory used is 128 * r * N bytes, so the
# defaults below are 64 MiB and about 270ms per unlock on a modern laptop.
# Raise N to make every attacker guess more expensive; you pay the same cost once.
# A typo here is reported as an error rather than silently reverting to the default.
VAULT_SCRYPT_N=65536
VAULT_SCRYPT_R=8
VAULT_SCRYPT_P=1

# Where `vault backup` writes. Default: <vault directory>/backups
VAULT_BACKUP_DIR=

# Allow the Have I Been Pwned breach lookup. OFF by default. When enabled, five hex
# characters of a password's SHA-1 leave the machine - never the password or the full
# hash. Per-command override: --online / --offline.
VAULT_HIBP=0

# debug | info | warn | error | off. Default warn. Logs go to stderr only, so stdout
# stays usable for piping (`vault get x --raw | ...`).
VAULT_LOG_LEVEL=warn

# ESCAPE HATCH, NOT A FEATURE. Supplies the master password non-interactively for
# scripts and the test suite. Environment variables are visible in /proc/<pid>/environ,
# inherit into child processes, and land in shell history when set inline. The CLI
# prints a warning whenever it is used. Leave this unset.
VAULT_PASSWORD=
